# =============================================================================
# Oma Midas Global Limited — Server Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit your .env file to version control.
# =============================================================================

# ----------------------------------------------------------------------------
# Server
# The TCP port the Express server listens on. Default: 5000
# ----------------------------------------------------------------------------
PORT=5000

# ----------------------------------------------------------------------------
# Database
# Supabase / PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Both fields point to the same URL (directUrl used by Prisma for migrations).
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# Authentication
# JWT_SECRET   — a long random string, at least 64 chars. Keep it secret.
# JWT_EXPIRES_IN — token lifetime, e.g. 7d, 1h.
# ----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# Paystack
# Obtain from https://dashboard.paystack.com/#/settings/developers
# Use sk_test_ / pk_test_ for development; sk_live_ / pk_live_ for production.
# ----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# CORS — the exact origin of the React frontend (no trailing slash)
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------------------
# Email (SMTP)
# For Gmail: enable 2-Factor Auth and create an App Password.
# EMAIL_FROM uses RFC 5321 "Name <address>" format.
# ----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Oma Midas <noreply@omamidas.com>

# ----------------------------------------------------------------------------
# Runtime environment: development | production | test
# ----------------------------------------------------------------------------
NODE_ENV=development

# ----------------------------------------------------------------------------
# Sentry (optional)
# Leave blank to disable error tracking. Provide DSN to enable it.
# Format: https://<key>@<org>.ingest.sentry.io/<project>
# ----------------------------------------------------------------------------
SENTRY_DSN=

# ----------------------------------------------------------------------------
# Backup cron (optional)
# Set to 'true' to enable the weekly pg_dump backup job (runs Sundays at 2 AM).
# Requires pg_dump to be installed and DATABASE_URL to be set.
# ----------------------------------------------------------------------------
ENABLE_BACKUP_CRON=false
