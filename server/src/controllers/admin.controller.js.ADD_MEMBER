// ADD THIS FUNCTION TO admin.controller.js after approveMember

// ---------------------------------------------------------------------------
// createMember — admin creates a member account directly
// ---------------------------------------------------------------------------
export async function createMember(req, res, next) {
  try {
    const {
      fullName,
      email,
      phone,
      nin,
      address,
      password,
      bankName,
      bankCode,
      accountNumber,
      accountName,
      memberType = 'NEW',
    } = req.body;

    // Validation
    if (!fullName || !email || !phone || !password || !bankName || !accountNumber || !accountName) {
      return res.status(422).json({
        error: 'Missing required fields: fullName, email, phone, password, bankName, accountNumber, accountName',
      });
    }

    // Check if email already exists
    const existing = await prisma.user.findUnique({ where: { email } });
    if (existing) {
      return res.status(409).json({ error: 'An account with this email already exists' });
    }

    // Hash password
    const bcrypt = await import('bcryptjs');
    const passwordHash = await bcrypt.default.hash(password, 12);

    // Create member with ACTIVE status
    const user = await prisma.user.create({
      data: {
        fullName,
        email,
        phone,
        nin: nin || null,
        address: address || null,
        passwordHash,
        bankName,
        bankCode: bankCode || '',
        accountNumber,
        accountName,
        status: 'ACTIVE', // Created by admin = auto-approved
        role: 'MEMBER',
        memberType,
      },
    });

    // Send welcome email
    sendApprovalEmail(user).catch((err) => logger.error('sendApprovalEmail failed', err));

    // Create notification
    await createNotification(prisma, {
      userId: user.id,
      title: 'Account Created',
      message: 'Your account has been created by admin. Welcome to Oma Midas!',
      type: 'ACCOUNT_APPROVED',
    });

    // Log audit
    await logAudit(req.user.id, 'CREATE_MEMBER', 'User', user.id, {
      email,
      memberType,
    });

    return res.status(201).json({
      message: 'Member created successfully',
      user: {
        id: user.id,
        fullName: user.fullName,
        email: user.email,
        status: user.status,
        memberType: user.memberType,
      },
    });
  } catch (err) {
    next(err);
  }
}
