# =============================================================================
# Oma Midas Global Limited — Client Environment Variables
# Copy this file to .env and fill in the actual values.
# All VITE_ prefixed variables are exposed to the browser bundle.
# NEVER put secrets in client-side environment variables.
# =============================================================================

# Base URL of the Express API (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Paystack public key — safe to expose in the browser
# Obtain from https://dashboard.paystack.com/#/settings/developers
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
